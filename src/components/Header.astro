---
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { NAVIGATION } from "../config/theme.config.ts";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = current === "/";
const activeClass = isHome ? "home-header-link is-active" : "text-foreground";
const inactiveClass = isHome
  ? "home-header-link"
  : "text-muted-foreground transition-colors hover:text-foreground";
const headerClass = isHome
  ? "sticky top-0 z-40 border-b border-transparent bg-transparent text-white"
  : "sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md";
const iconClass = isHome
  ? "home-header-action inline-flex h-9 w-9 items-center justify-center rounded-full transition-colors"
  : "inline-flex h-9 w-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground";
---

<header class={headerClass} data-home-header={isHome ? "true" : undefined} data-scrolled="false">
  <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-2 italic">
      <span class={`font-serif text-xl font-semibold ${isHome ? "home-header-brand" : ""}`}>{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary navigation">
      {
        NAVIGATION.map((item) => {
          const exact = item.to === "/";
          const active = exact ? current === "/" : current.startsWith(item.to);
          return (
            <a
              href={item.to}
              class={`text-sm ${active ? activeClass : inactiveClass}`}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-search-toggle
        aria-label="Search"
        aria-controls="site-search"
        aria-expanded="false"
        class={iconClass}
      >
        <Icon name="search" class="h-4 w-4" />
      </button>
      <a
        href="/rss.xml"
        aria-label="RSS feed"
        class={`${iconClass} hidden sm:inline-flex`}
      >
        <Icon name="rss" class="h-4 w-4" />
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle dark mode"
        class={iconClass}
      >
        <span data-theme-icon="moon"><Icon name="moon" class="h-4 w-4" /></span>
        <span data-theme-icon="sun" hidden><Icon name="sun" class="h-4 w-4" /></span>
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class={`${iconClass} md:hidden`}
      >
        <span data-menu-icon="menu"><Icon name="menu" class="h-4 w-4" /></span>
        <span data-menu-icon="x" hidden><Icon name="x" class="h-4 w-4" /></span>
      </button>
    </div>
  </div>

  <dialog
    id="site-search"
    data-search-panel
    aria-labelledby="site-search-title"
    class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-2xl border border-border/70 bg-background p-0 text-foreground shadow-[0_32px_90px_-24px_oklch(0.08_0.02_60_/_0.65)] backdrop:bg-black/55 backdrop:backdrop-blur-sm"
  >
    <div class="flex items-center justify-between border-b border-border/60 px-5 py-4 sm:px-6">
      <div>
        <h2 id="site-search-title" class="font-serif text-xl font-semibold">Search the archive</h2>
        <p class="mt-0.5 text-xs text-muted-foreground">Essays, field notes, and interviews</p>
      </div>
      <button
        type="button"
        data-search-close
        aria-label="Close search"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <Icon name="x" class="h-4 w-4" />
      </button>
    </div>
    <form action="/blog" method="get" role="search" class="p-4 sm:p-6">
      <label for="site-search-input" class="sr-only">Search essays, field notes, interviews</label>
      <div class="flex items-center gap-3 rounded-xl border border-border/80 bg-card px-4 shadow-sm transition-[border-color,box-shadow] focus-within:border-primary/60 focus-within:ring-4 focus-within:ring-primary/10">
        <Icon name="search" class="h-5 w-5 shrink-0 text-muted-foreground" />
        <input
          id="site-search-input"
          data-search-input
          type="search"
          name="q"
          enterkeyhint="search"
          placeholder="Search essays, field notes, interviews..."
          class="min-w-0 flex-1 border-0 bg-transparent py-3.5 font-serif text-lg outline-none placeholder:text-muted-foreground/80"
        />
        <button
          type="submit"
          class="shrink-0 rounded-lg bg-foreground px-4 py-2 text-sm font-medium text-background transition-colors hover:bg-primary hover:text-primary-foreground"
        >
          Search
        </button>
      </div>
    </form>
  </dialog>

  <div id="mobile-menu" data-menu-panel class="border-t border-border/60 bg-background text-foreground md:hidden" hidden>
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-3" aria-label="Mobile navigation">
      {
        NAVIGATION.map((item) => {
          const exact = item.to === "/";
          const active = exact ? current === "/" : current.startsWith(item.to);
          return (
            <a
              href={item.to}
              class={`rounded-md px-2 py-2 text-sm hover:bg-muted hover:text-foreground ${active ? "text-foreground" : "text-muted-foreground"}`}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  const searchToggle = document.querySelector("[data-search-toggle]");
  const searchPanel = document.querySelector("[data-search-panel]");
  const searchInput = document.querySelector("[data-search-input]");
  const searchClose = document.querySelector("[data-search-close]");
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const menuPanel = document.querySelector("[data-menu-panel]");
  const menuIcon = document.querySelector('[data-menu-icon="menu"]');
  const closeIcon = document.querySelector('[data-menu-icon="x"]');
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const moonIcon = document.querySelector('[data-theme-icon="moon"]');
  const sunIcon = document.querySelector('[data-theme-icon="sun"]');
  const homeHeader = document.querySelector("[data-home-header]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let searchCloseTimer;

  const setPanelOpen = () => {
    if (!homeHeader) return;
    const open = searchPanel.open || !menuPanel.hidden;
    homeHeader.dataset.panelOpen = String(open);
  };

  const setMenu = (open) => {
    menuPanel.hidden = !open;
    menuIcon.hidden = open;
    closeIcon.hidden = !open;
    menuToggle?.setAttribute("aria-expanded", String(open));
    setPanelOpen();
  };

  const openSearch = () => {
    clearTimeout(searchCloseTimer);
    searchPanel.classList.remove("is-closing");
    setMenu(false);
    if (!searchPanel.open) searchPanel.showModal();

    const customCursor = document.getElementById("custom-cursor");
    if (matchMedia("(pointer: fine)").matches && typeof customCursor?.showPopover === "function") {
      if (customCursor.matches(":popover-open")) customCursor.hidePopover();
      customCursor.showPopover();
    }

    searchToggle?.setAttribute("aria-expanded", "true");
    searchInput?.focus();
    setPanelOpen();
  };

  const closeSearch = () => {
    if (!searchPanel.open || searchPanel.classList.contains("is-closing")) return;
    searchToggle?.setAttribute("aria-expanded", "false");

    const finishClose = () => {
      searchPanel.close();
      const customCursor = document.getElementById("custom-cursor");
      if (typeof customCursor?.hidePopover === "function" && customCursor.matches(":popover-open")) {
        customCursor.hidePopover();
      }
      searchPanel.classList.remove("is-closing");
      setPanelOpen();
      searchToggle?.focus();
    };

    if (reducedMotion.matches) {
      finishClose();
    } else {
      searchPanel.classList.add("is-closing");
      searchCloseTimer = setTimeout(finishClose, 140);
    }
  };

  const setThemeIcon = () => {
    const dark = document.documentElement.classList.contains("dark");
    moonIcon.hidden = dark;
    sunIcon.hidden = !dark;
  };

  setThemeIcon();

  const setHeaderScrolled = () => {
    if (!homeHeader) return;
    homeHeader.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
  };
  setHeaderScrolled();
  window.addEventListener("scroll", setHeaderScrolled, { passive: true });

  searchToggle?.addEventListener("click", () => {
    if (searchPanel.open) closeSearch();
    else openSearch();
  });
  searchClose?.addEventListener("click", closeSearch);

  searchPanel.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeSearch();
  });

  searchPanel.addEventListener("click", (event) => {
    if (event.target !== searchPanel) return;
    const rect = searchPanel.getBoundingClientRect();
    const inside =
      event.clientX >= rect.left &&
      event.clientX <= rect.right &&
      event.clientY >= rect.top &&
      event.clientY <= rect.bottom;
    if (!inside) closeSearch();
  });

  menuToggle?.addEventListener("click", () => setMenu(menuPanel.hidden));

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || menuPanel.hidden) return;
    setMenu(false);
    menuToggle?.focus();
  });

  themeToggle?.addEventListener("click", () => {
    const next = !document.documentElement.classList.contains("dark");
    document.documentElement.classList.toggle("dark", next);
    localStorage.setItem("theme", next ? "dark" : "light");
    setThemeIcon();
  });
</script>
