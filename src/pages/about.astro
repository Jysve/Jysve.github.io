---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/blog-data.js";
import aboutImg from "../assets/about.png";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE.url}/about#webpage`,
  "url": `${SITE.url}/about`,
  "inLanguage": SITE.locale,
  "mainEntity": {
    "@type": "Person",
    "@id": `${SITE.url}/about#person`,
    "name": "Jysve",
    "alternateName": ["Sve", "Svecco"],
    "url": `${SITE.url}/about`,
    "image": `${SITE.url}/avatars/jysve.webp`,
    "jobTitle": "Developer",
    "description": `${SITE.description}`,
    "knowsAbout": [
      "Rust", "Apache", "Linux", "Math",
      "NSE", "SRE", "SELinux", "CNCF"
    ],
    "sameAs": [
      "https://github.com/Jysve" ,
      "https://www.zhihu.com/people/Jysve" ,
      "https://space.bilibili.com/246563710",
    ]
  }
};
---

<BaseLayout
  title={`About - ${SITE.name}`}
  description={`About ${SITE.name} | Technical, Academic, and Daily Life.`}
  jsonLd={jsonLd}
  ogImage={SITE.ogImg}
  canonical="/about"
>
  <div class="mx-auto max-w-6xl px-5 py-12">
    <header class="mt-10">
      <h1 class="font-serif text-6xl font-medium leading-[1.02] tracking-tight sm:text-7xl">
        A Personal Blog
        <br class="hidden sm:block" /> Written for{" "}
        <span class="font-mono italic">
      Jysve{" "}
          <span class="font-serif text-[0.5em] text-gray-500">
        /ˈdʒes.vi/
      </span>
    </span>
      </h1>
    </header>

    <section class="mt-14 grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="mx-auto w-full max-w-md overflow-hidden rounded-2xl">
        <Image
          src={aboutImg}
          alt=""
          widths={[448, 640, 896]}
          sizes="(min-width: 1024px) 28rem, 100vw"
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="text-base leading-relaxed">
        <ul class="space-y-5 font-serif text-lg italic">
          <li>Born in '08, made in China.</li>
          <li>Rust by day, Go by night.</li>
          <li>Fedora on disk, Mod-DH on keys.</li>
          <li>Skeptical of AI, faithful to RWKV.</li>
          <li>Occasionally math, accidentally physics.</li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
