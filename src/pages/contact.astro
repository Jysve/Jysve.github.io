---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT, FORMS } from "../config/theme.config.ts";

const hasContactEndpoint = Boolean(FORMS.contact.action);
const contactAction = hasContactEndpoint ? FORMS.contact.action : "/contact";
const contactMethod = hasContactEndpoint ? FORMS.contact.method : "get";
const contactEnctype = hasContactEndpoint ? FORMS.contact.enctype : undefined;
---

<BaseLayout
  title={`Contact - ${SITE.name}`}
  description={`Get in touch with ${SITE.name}.`}
  canonical="/contact"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "Contact" }]} />
    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Contact</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold">Come chat with me, submissions also accepted :)</h1>
      <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
        You can reach out to chat, report bugs & errors, offer content suggestions, or submit your original works for consideration.
        I will reply as soon as possible, but please allow several days for a response.
        Spam and advertising messages will be ignored.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href="mailto:Jv@sve.moe"
          class="group italic inline-flex items-center gap-2 border-b border-foreground pb-1 text-sm font-medium text-foreground transition-opacity hover:opacity-70"
        >
          Mail to <strong>Jv@sve.moe</strong>
          <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href="https://discord.com"
          class="group italic inline-flex items-center gap-2 border-b border-foreground pb-1 text-sm font-medium text-foreground transition-opacity hover:opacity-70"
        >
          Touch via Discord <strong>@Jysve</strong>
          <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </header>
  </div>
</BaseLayout>
